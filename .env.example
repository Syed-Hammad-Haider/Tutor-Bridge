# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project Settings → Environment Variables before you
# deploy. See README.md for full setup instructions for each one.

# --- Supabase (database) ---------------------------------------------------
# Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" secret key (NOT the anon/public key). This is used
# server-side only and must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin dashboard (/admin) ----------------------------------------------
# Choose a strong password — this protects your submissions dashboard.
ADMIN_PASSWORD=choose-a-strong-password

# --- Live push notifications (ntfy.sh) -------------------------------------
# Pick a hard-to-guess topic name (treat it like a password — anyone who
# knows it can send to your topic). No account signup required.
NTFY_TOPIC=tutorbridge-yourname-x7k2
# Optional: only needed if you're self-hosting ntfy instead of ntfy.sh
# NTFY_SERVER=https://ntfy.sh

# --- AI chat assistant (Google Gemini — free tier) --------------------------
# Get a key from aistudio.google.com → Get API Key. This powers Bridget, the
# floating chat assistant that answers academic and TutorBridge questions.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model if Google renames/retires the default one.
# GEMINI_MODEL=gemini-3.6-flash
